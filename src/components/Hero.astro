---
const tools = ["Claude Code", "Codex", "OpenCode", "Pi"];
const facts = [
  { k: "Runs on", v: "Apple Silicon" },
  { k: "Stays", v: "on this Mac" },
  { k: "Listens on", v: "localhost:6767" },
];
---

<section class="hero">
  <div class="container container--wide frame">
    <div class="board">
      <div class="copy">
        <h1>Run any model<br />in the tool you already have.</h1>
        <p class="lede">
          A local server on your Mac.<br />
          Point Claude Code, Codex, OpenCode, or Pi at it once.
        </p>
        <div class="install-cmd" data-copy="uv tool install ppmlx" role="button" tabindex="0" aria-label="Copy the ppmlx install command">
          <span class="prompt">$</span>
          <span>uv tool install ppmlx</span>
          <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          <span class="tooltip">Copied</span>
        </div>
      </div>

      <dl class="facts">
        {facts.map(({ k, v }) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <ul class="tools">
      {tools.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    overflow: hidden;
    min-height: 100svh;
    padding: 120px 0 48px;
  }
  .hero::before {
    position: absolute;
    top: 8%;
    left: -8%;
    z-index: -1;
    width: min(720px, 70vw);
    height: min(520px, 55vh);
    content: '';
    background: radial-gradient(ellipse, rgba(212, 131, 60, 0.14), transparent 68%);
    pointer-events: none;
  }
  .frame {
    display: flex;
    flex-direction: column;
    gap: 56px;
    width: 100%;
  }
  .board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(40px, 8vw, 96px);
    align-items: start;
  }
  h1 {
    max-width: 11em;
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.96;
  }
  .lede {
    margin: 0 0 32px;
    color: var(--text-secondary);
    font-size: clamp(17px, 1.5vw, 19px);
    font-weight: 300;
    line-height: 1.5;
  }
  .copy :global(.install-cmd) {
    padding: 16px 22px;
    border-color: #2a241c;
    background: #14110e;
    font-size: 15px;
    box-shadow: 0 0 0 1px rgba(212, 131, 60, 0.08);
  }

  .facts {
    display: grid;
    gap: 22px;
    margin: 0;
    padding-top: 10px;
  }
  .facts div { margin: 0; }
  .facts dt {
    margin: 0 0 4px;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .facts dd {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 15px;
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin: 0;
    padding-top: 22px;
    border-top: 1px solid var(--border);
    list-style: none;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  @media (max-width: 800px) {
    .hero { padding-top: 112px; }
    .frame { min-height: 0; gap: 40px; }
    .board { grid-template-columns: 1fr; gap: 36px; }
    h1 { max-width: none; }
    .copy :global(.install-cmd) { width: 100%; justify-content: center; }
    .facts { grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
  }
  @media (max-width: 520px) {
    .facts { grid-template-columns: 1fr; }
  }
</style>
