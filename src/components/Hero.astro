---
import { release } from "../data/release";
import RouterMark from "./RouterMark.astro";
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-art" aria-hidden="true"><RouterMark /></div>
  <div class="hero-fade" aria-hidden="true"></div>
  <div class="hero-copy container">
    <h1 id="hero-title">One local router.<br />All your models.</h1>
    <p class="lede">Use the models and subscriptions you choose. Set the routes. Keep your context on your Mac.</p>
    <div class="hero-actions">
      <button class="install-command" type="button" data-copy="uv tool install ppmlx" aria-label="Copy install command">
        <code>uv tool install ppmlx</code>
        <span class="copy-icons" aria-hidden="true"><svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M15 8V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h4"/></svg><svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg></span>
      </button>
      <a href="#quickstart" class="quiet-link setup-link">Get started</a>
    </div>
    <p class="copy-status" role="status" aria-live="polite"></p>
    <p class="release-meta"><a href="https://github.com/wydrox/ppmlx/blob/main/CHANGELOG.md">v{release} development</a><span>Apple Silicon</span></p>
  </div>
</section>
<style>
.hero { position: relative; isolation: isolate; overflow: hidden; min-height: 632px; padding-top: 140px; padding-bottom: 140px; }
.hero-copy { position: relative; z-index: 1; }
h1 { font-size: clamp(42px, 5.25vw, 64px); line-height: 1.1; letter-spacing: -.055em; font-weight: 450; margin-bottom: 30px; }
.lede { max-width: 450px; font-size: 18px; line-height: 1.8; margin-bottom: 34px; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; }
.install-command { display: inline-flex; align-items: center; gap: 24px; min-height: 48px; padding: 0 17px; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: var(--text-primary); transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease; }
.install-command code { font-size: 12px; }
.install-command:hover { border-color: var(--text-dim); background: var(--bg-surface); }
.install-command:active { transform: translateY(1px); }
.install-command:disabled { cursor: wait; }
.copy-icons { display: grid; color: var(--text-dim); }
.copy-icons svg { grid-area: 1 / 1; transition: opacity 180ms ease, transform 180ms ease; }
.check-icon { opacity: 0; transform: scale(.8); color: var(--teal); }
[data-copy-state="copied"] .copy-icon { opacity: 0; transform: scale(.8); }
[data-copy-state="copied"] .check-icon { opacity: 1; transform: scale(1); }
.setup-link { color: var(--text-primary); font-size: 13px; }
.copy-status { min-height: 20px; font-size: 12px; color: var(--teal); margin: 8px 0 0; }
.release-meta { display: flex; gap: 10px 22px; flex-wrap: wrap; align-items: center; font-size: 11px; color: var(--text-dim); margin: 4px 0 0; }
.release-meta a { color: var(--text-dim); text-decoration: none; }
.release-meta a:hover { color: var(--text-primary); }
.hero-art { position: absolute; inset: -88px 0 0; z-index: -2; pointer-events: none; }
.hero-fade { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(90deg, var(--bg-deep) 0%, rgba(17,18,20,.94) 33%, transparent 65%); }
@media (max-width: 760px) {
  .hero { min-height: calc(100svh - 112px); padding-top: 64px; padding-bottom: 340px; }
  h1 { font-size: clamp(36px, 10.75vw, 42px); }
  .lede { font-size: 16px; max-width: 480px; }
  .hero-actions { gap: 16px; }
  .install-command { gap: 12px; padding-inline: 12px; }
  .hero-art { inset: auto -30px -30px auto; width: 780px; height: 468px; opacity: .8; }
  .hero-fade { background: linear-gradient(180deg, var(--bg-deep) 0%, rgba(17,18,20,.98) 35%, rgba(17,18,20,.25) 65%, transparent 100%); }
}
</style>
