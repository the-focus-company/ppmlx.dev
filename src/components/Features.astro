---
const features = [
  { title: "Local MLX inference", desc: "Run quantized language models on Apple Silicon with native MLX execution." },
  { title: "Three agent protocols", desc: "Use Chat Completions, Responses, or Anthropic Messages with one local server." },
  { title: "Local tool calls", desc: "Stream tool calls to Codex, Claude Code, OpenCode, and other compatible clients." },
  { title: "Vision and embeddings", desc: "Use local images and vectors through optional MLX packages and the same server." },
  { title: "168+ model aliases", desc: "Select Llama, Qwen, Mistral, Phi, Gemma, DeepSeek, and other curated MLX models." },
  { title: "Experimental memory", desc: "Capture scoped events locally. Inspect the graph through CLI and MCP tools." },
];
const compat = ["Claude Code", "Codex", "OpenCode", "Pi", "Open WebUI", "OpenAI SDKs"];
---

<section class="section" id="features">
  <div class="container container--wide">
    <div class="section-label reveal">What ships today</div>
    <h2 class="section-title reveal reveal-delay-1">Local inference is still the foundation.</h2>
    <p class="section-sub reveal reveal-delay-2" style="margin-bottom:40px">
      Install one Python package. Run the server on your Mac. Connect through the protocol that your tool expects.
    </p>

    <div class="features-grid reveal reveal-delay-3">
      {features.map(({ title, desc }) => (
        <div class="feature-card">
          <h3>{title}</h3>
          <p>{desc}</p>
        </div>
      ))}
    </div>

    <div class="compat-line reveal">
      Local model access for {compat.map((c, i) => <><span>{c}</span>{i < compat.length - 1 ? " \u00b7 " : ""}</>)}
    </div>
    <div class="roadmap-line reveal">
      One policy layer for remote providers &middot; model normalization &middot; read grants
      &mdash; <a href="https://github.com/wydrox/ppmlx/issues" target="_blank" rel="noopener">see the issues &rarr;</a>
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid; grid-template-columns: 1fr; gap: 1px;
    background: var(--border); border: 1px solid var(--border);
    border-radius: 12px; overflow: hidden; margin-bottom: 32px;
  }
  @media (min-width: 900px) {
    .features-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .feature-card {
    background: var(--bg-surface); padding: 28px 24px;
    transition: background 0.3s, transform 0.2s; position: relative;
  }
  .feature-card:hover { z-index: 1; background: var(--bg-elevated); box-shadow: 0 18px 42px rgba(0, 0, 0, 0.22); transform: translateY(-4px); }
  .feature-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: transparent; transition: background 0.3s;
  }
  .feature-card:hover::before { background: linear-gradient(90deg, transparent, var(--accent), transparent); }
  .feature-card h3 { font-family: var(--font-body); font-size: 15px; font-weight: 500; color: var(--text-primary); margin-bottom: 6px; }
  .feature-card h3 { transition: color 0.25s ease, transform 0.25s ease; }
  .feature-card:hover h3 { color: var(--accent-bright); transform: translateX(3px); }
  .feature-card p { font-size: 13px; color: var(--text-secondary); line-height: 1.55; font-weight: 300; }

  .compat-line {
    text-align: center; font-family: var(--font-mono); font-size: 13px; color: var(--text-dim);
    padding: 20px 0; margin-bottom: 8px;
  }
  .compat-line span { color: var(--text-secondary); font-weight: 400; }

  .roadmap-line {
    text-align: center; font-family: var(--font-mono); font-size: 12px; color: var(--text-dim);
  }
  .roadmap-line a { color: var(--accent); text-decoration: none; }
  .roadmap-line a:hover { color: var(--accent-bright); }
  @media (prefers-reduced-motion: reduce) {
    .feature-card:hover, .feature-card:hover h3 { transform: none; }
  }
</style>
