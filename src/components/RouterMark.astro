---
const splineTiming = {
  begin: "indefinite",
  dur: "8s",
  repeatCount: "indefinite",
  calcMode: "spline",
  keyTimes: "0;.25;.5;.75;1",
  keySplines: ".37 0 .63 1;.37 0 .63 1;.37 0 .63 1;.37 0 .63 1",
};
---
<figure class="router-motion" data-router-motion aria-hidden="true">
  <svg
    class="route-scene"
    data-route-scene
    xmlns="http://www.w3.org/2000/svg"
    width="100%"
    height="100%"
    viewBox="0 0 1200 720"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <g id="router-pattern-mark">
        <path d="M4 7h6l4 10h6M4 17h6l4-10h6" fill="none" stroke="currentColor" stroke-width="1.5" />
        <g fill="currentColor">
          <circle cx="4" cy="7" r="2" />
          <circle cx="4" cy="17" r="2" />
          <circle cx="20" cy="7" r="2" />
          <circle cx="20" cy="17" r="2" />
        </g>
      </g>

      <pattern id="router-pattern-small" width="32" height="24" patternUnits="userSpaceOnUse" patternTransform="translate(0 0)">
        <animateTransform
          data-route-morph
          attributeName="patternTransform"
          type="translate"
          values="0 0;-32 -24"
          dur="8s"
          repeatCount="indefinite"
          calcMode="linear"
          begin="indefinite"
        />
        <use href="#router-pattern-mark" transform="translate(4 0)" color="#c4b9e8" />
      </pattern>

      <pattern id="router-pattern-ambient" width="64" height="48" patternUnits="userSpaceOnUse" patternTransform="translate(0 0)">
        <animateTransform
          data-route-morph
          attributeName="patternTransform"
          type="translate"
          values="0 0;64 48"
          dur="8s"
          repeatCount="indefinite"
          calcMode="linear"
          begin="indefinite"
        />
        <use href="#router-pattern-mark" transform="translate(12 4) scale(1.6)" color="#c4b9e8" />
      </pattern>

      <linearGradient id="router-pattern-fade">
        <stop offset="0" stop-color="black" />
        <stop offset=".36" stop-color="black" />
        <stop offset=".53" stop-color="#171717" />
        <stop offset=".73" stop-color="#aaa" />
        <stop offset="1" stop-color="white" />
      </linearGradient>

      <linearGradient id="router-pattern-vertical" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="#777" />
        <stop offset=".22" stop-color="white" />
        <stop offset=".8" stop-color="white" />
        <stop offset="1" stop-color="#111" />
      </linearGradient>

      <radialGradient id="router-pattern-wave" gradientUnits="userSpaceOnUse" cx="920" cy="470" r="470">
        <animate data-route-morph attributeName="cx" values="920;1110;920;730;920" {...splineTiming} />
        <animate data-route-morph attributeName="cy" values="470;350;230;350;470" {...splineTiming} />
        <stop stop-color="white" />
        <stop offset="1" stop-color="#555" />
      </radialGradient>

      <mask id="router-pattern-field-fade">
        <rect width="1200" height="720" fill="url(#router-pattern-fade)" />
      </mask>
      <mask id="router-pattern-edge-fade">
        <rect width="1200" height="720" fill="url(#router-pattern-vertical)" />
      </mask>
      <mask id="router-pattern-routed">
        <g transform="translate(890 355)">
          <g transform="scale(35)">
            <animateTransform data-route-morph attributeName="transform" type="scale" values="35;35.875;35;34.125;35" {...splineTiming} />
            <g transform="translate(-12 -12)">
              <use href="#router-pattern-mark" color="white" />
            </g>
          </g>
        </g>
      </mask>
      <mask id="router-pattern-light-wave">
        <rect width="1200" height="720" fill="url(#router-pattern-wave)" />
      </mask>
    </defs>

    <rect width="1200" height="720" fill="#111214" />
    <g mask="url(#router-pattern-field-fade)">
      <g mask="url(#router-pattern-edge-fade)">
        <rect width="1200" height="720" fill="url(#router-pattern-ambient)" opacity=".075" />
        <g transform="translate(890 355)">
          <g transform="scale(35)">
            <animateTransform data-route-morph attributeName="transform" type="scale" values="35;35.875;35;34.125;35" {...splineTiming} />
            <g transform="translate(-12 -12)">
              <use href="#router-pattern-mark" color="#c4b9e8" opacity=".10" />
            </g>
          </g>
        </g>
        <g mask="url(#router-pattern-routed)">
          <rect width="1200" height="720" fill="url(#router-pattern-small)" opacity=".34" />
          <g mask="url(#router-pattern-light-wave)">
            <rect width="1200" height="720" fill="url(#router-pattern-small)" opacity=".40" />
          </g>
        </g>
      </g>
    </g>
  </svg>
</figure>
<style>
.router-motion { width: 100%; height: 100%; margin: 0; }
.route-scene { display: block; width: 100%; height: 100%; }
</style>
<script>
  import { initRouterMotion } from "./router-motion";
  initRouterMotion();
</script>
