<style>
.router-motion { width: 100%; max-width: 360px; margin: 0; }
.route-scene { display: block; width: 100%; height: auto; overflow: visible; }
.route-bundle { fill: none; stroke-linecap: round; color: var(--accent); }
.route-bundle--b { color: var(--teal); }
.route-edge { stroke: currentColor; stroke-width: .7; opacity: .16; }
.route-track { stroke: currentColor; stroke-width: 1.3; opacity: .6; }
.route-flow { stroke: currentColor; animation: route-travel 6s linear infinite; animation-play-state: paused; }
.route-tail { stroke-width: 2; stroke-dasharray: 74 926; opacity: .55; }
.route-packet { stroke-width: 4; stroke-dasharray: 1 999; }
.route-bundle--b .route-flow { animation-duration: 8s; animation-delay: -3s; }
.route-terminals { fill: var(--bg-deep); stroke: var(--border); stroke-width: 1.4; }
.terminal-points { fill: var(--accent); }
.point-local { fill: var(--teal); }
.center-disc { fill: var(--bg-deep); stroke: var(--border); stroke-width: 1; }
.center-orbit { fill: none; stroke: var(--text-secondary); stroke-width: .8; stroke-dasharray: 22 79.53; transform-origin: 180px 160px; animation: route-orbit 24s linear infinite; animation-play-state: paused; opacity: .55; }
.center-breath { fill: none; stroke: var(--accent); stroke-width: .7; transform-origin: 180px 160px; animation: route-breath 8s ease-in-out infinite; animation-play-state: paused; }
.center-point { fill: var(--text-primary); }
[data-running="true"] .route-flow, [data-running="true"] .center-orbit, [data-running="true"] .center-breath { animation-play-state: running; }
.motion-toggle { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 0; margin-top: 14px; border: 0; background: transparent; color: var(--text-dim); font: 12px/1.5 var(--font-mono); transition: color 180ms ease; }
.motion-toggle[hidden] { display: none; }
.motion-toggle:hover { color: var(--accent); }
.motion-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
@keyframes route-travel { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -1000; } }
@keyframes route-orbit { to { transform: rotate(360deg); } }
@keyframes route-breath { 0%, 100% { transform: scale(.9); opacity: .45; } 50% { transform: scale(1.15); opacity: .85; } }
@media (prefers-reduced-motion: reduce) {
  .route-flow, .center-orbit, .center-breath { animation: none; }
  .route-flow { opacity: 0; }
}
</style>

