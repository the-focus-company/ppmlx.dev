---
const routes = [
  { y: 4, closeY: 6 },
  { y: 12, closeY: 12 },
  { y: 20, closeY: 18 },
];
const routePath = (y: number, split: number) => `M4 12H${split}L16 ${y}H20`;
const timing = {
  begin: "indefinite",
  dur: "14s",
  repeatCount: "indefinite",
  calcMode: "spline",
  keyTimes: "0;.15;.45;.60;1",
  keySplines: ".65 0 .35 1;.65 0 .35 1;.65 0 .35 1;.65 0 .35 1",
};
---
<figure class="router-motion" data-router-motion>
  <svg class="route-scene" data-route-scene viewBox="0 0 24 24" aria-hidden="true">
    <g fill="none" stroke="var(--accent)" stroke-width="1.5">
      {routes.map(({ y, closeY }) => {
        const open = routePath(y, 8);
        const closed = routePath(closeY, 12);
        return <path d={open}><animate data-route-morph attributeName="d" {...timing} values={[open, open, closed, closed, open].join(";")} /></path>;
      })}
    </g>
    <g fill="var(--accent)">
      <circle cx="4" cy="12" r="2" />
      {routes.map(({ y, closeY }) => <circle cx="20" cy={y} r="2"><animate data-route-morph attributeName="cy" {...timing} values={[y, y, closeY, closeY, y].join(";")} /></circle>)}
    </g>
  </svg>
</figure>
<style>
.router-motion { width: 100%; max-width: 340px; margin: 0; }
.route-scene { display: block; width: 100%; max-width: 320px; height: auto; }
</style>
<script>
  import { initRouterMotion } from "./router-motion";
  initRouterMotion();
</script>
