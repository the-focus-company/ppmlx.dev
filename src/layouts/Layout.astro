---
import "../styles/global.css";
import { release } from "../data/release";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ppmlx — local models for coding agents on Apple Silicon" />
    <meta property="og:site_name" content="ppmlx" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="ppmlx — local models for coding agents on Apple Silicon" />
    <meta name="keywords" content="MLX, Apple Silicon, LLM, local inference, Ollama alternative, OpenAI API, macOS, M1, M2, M3, M4, Metal GPU, ppmlx" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "ppmlx",
      "url": "https://ppmlx.dev",
      "description": "Local MLX inference for Apple Silicon, with model routing, tool normalization, and explicit memory for coding agents.",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS (Apple Silicon)",
      "license": "https://opensource.org/licenses/MIT",
      "downloadUrl": "https://pypi.org/project/ppmlx/",
      "codeRepository": "https://github.com/wydrox/ppmlx",
      "softwareVersion": release,
      "author": { "@type": "Organization", "name": "The Focus Company", "url": "https://thefocus.company" },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "featureList": [
        "MLX-native inference on Apple Silicon Metal GPU",
        "Local OpenAI-compatible API with Chat Completions, Responses, and Embeddings",
        "Local Anthropic Messages API",
        "168+ curated model registry with human aliases",
        "Local tool calling for coding agents",
        "Vision model support via mlx-vlm",
        "Interactive TUI model picker and chat REPL",
        "Experimental local temporal memory graph",
        "Published Apple Silicon benchmarks against Ollama"
      ]
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
    <script>
      document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const status = document.querySelector<HTMLElement>(".copy-status");
          try {
            await navigator.clipboard.writeText(button.dataset.copy || "");
            if (status) status.textContent = "Command copied.";
          } catch {
            if (status) status.textContent = "Copy failed. Select and copy the command above.";
          }
        });
      });
    </script>
  </body>
</html>
